# Service profile. KEY=value only; no shell expressions or quoted values.
# /etc/usque/config.json contains credentials; keep it root:usque 0640.
USQUE_CONFIG=/etc/usque/config.json
USQUE_BINARY=/opt/usque/current/usque
USQUE_STATE=/run/usque/status.json
USQUE_BIND=127.0.0.1
USQUE_PORT=903
USQUE_MODE=socks
# Optional comma-separated literal DNS IPs (at most 8); empty uses core defaults.
# Example: USQUE_DNS=1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001
# Full socks sends DNS through WARP; l4-socks resolves over the host network.
USQUE_DNS=
# Public listening requires USQUE_ALLOW_PUBLIC=true. SOCKS has no encryption;
# configure native authentication and protect it with an encrypted transport.
USQUE_ALLOW_PUBLIC=false
# Optional native SOCKS authentication. Linux regular file, root:usque 0640,
# no symlink, bounded JSON containing username and password (1..255 UTF-8 bytes).
# Only this file path is passed to the child; credentials stay out of argv.
# USQUE_SOCKS_AUTH_FILE=/etc/usque/socks-auth.json
# Optional per-client SOCKS traffic monitoring. Provision the separate directory
# first: usque:usque-clients 2750, with clients.json mode 0640. The panel gets only
# the dedicated read group, never the credential group. No secrets are stored.
# Monitoring checkpoints every 2s; abrupt exits can lose the latest interval.
# USQUE_CLIENT_STATS_FILE=/var/lib/usque-clients/clients.json
USQUE_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace
# A WARP stall is detected in about HEALTH_INTERVAL*FAILURES+HEALTH_TIMEOUT
# (about 15s with these values) and the child is restarted.
USQUE_HEALTH_INTERVAL=5s
USQUE_HEALTH_TIMEOUT=5s
USQUE_HEALTH_FAILURES=2
USQUE_DIAL_TIMEOUT=8s
USQUE_SHUTDOWN_TIMEOUT=8s
USQUE_BACKOFF_MIN=1s
USQUE_BACKOFF_MAX=30s
USQUE_HEALTHY_RESET=2m
USQUE_ALWAYS_RECONNECT=true
USQUE_MTU=1280
USQUE_HTTP2=false
# MASQUE transport failover order: quic:PORT or http2:PORT, comma-separated.
# Each restart moves to the next entry. Empty uses USQUE_HTTP2 on port 443.
# l4-socks supports quic entries only.
USQUE_TRANSPORTS=quic:443,http2:443,quic:4500
